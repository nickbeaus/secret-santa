# Copy to .env and fill in. Restart after changes:  docker compose up -d

# Port on the Docker host that serves the site.
HOST_PORT=8080

# Public address of the site, used in reveal links and texts. Must end with /.
BASE_URL=https://xmas.example.org/

# Timezone for showing dates and deciding the drawing year.
APP_TIMEZONE=America/Chicago

# IP address(es) of your reverse proxy, comma-separated. Requests from these are trusted
# to report the real visitor IP and https via X-Forwarded-For / X-Forwarded-Proto.
# Leave empty if visitors connect directly.
TRUSTED_PROXIES=

# --- Texting through VoIP.ms (optional; the "Send from My Phone" page works without it) ---
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
# The SMS/MMS-enabled VoIP.ms number texts come from (10 digits).
VOIPMS_DID=

# While true, every VoIP.ms and phone-page text goes to SMS_TEST_NUMBER instead of participants.
SMS_TEST_MODE=true
SMS_TEST_NUMBER=
